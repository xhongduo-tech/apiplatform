{
  "name": "open-api-platform-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "browserslist": [
    "chrome >= 60",
    "firefox >= 60",
    "safari >= 11",
    "edge >= 18"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/externalize-legacy-bootstrap.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "gen:zh-tw": "node scripts/gen-model-readme-zh-tw.mjs",
    "test": "vitest run --exclude 'e2e/**'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/noto-sans-sc": "^5.2.10",
    "@fontsource-variable/noto-sans-tc": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@fontsource/jetbrains-mono": "5.1.0",
    "clsx": "^2.1.1",
    "dompurify": "3.4.14",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.18.2",
    "recharts": "3.10.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-legacy": "8.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.5.5",
    "esbuild": "0.28.2",
    "opencc-js": "^1.4.1",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "terser": "5.51.2",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "overrides": {
    "dompurify": "3.4.14"
  }
}
