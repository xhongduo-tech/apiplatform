    "/v1/messages/count_tokens": {
      "post": {
        "description": "A社 count_tokens 兼容端点（CC 启动即调用）。\n\n自掌控 vLLM 上游没有对应接口，返回网关的字符级估算（与 TPM 预扣同一\n套算法）——对上下文管理场景精度足够，且零上游开销。\n\n虽然不打上游，仍走一遍 enforce_pre：Key 状态、模型权限与 RPM 校验和其它\n端点同口径，避免这里成为绕过策略的口子。est_tokens 传 0——本端点不消耗\n上游 token，不该占用调用方的 TPM 预算。",
        "operationId": "count_tokens_v1_messages_count_tokens_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-api-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Count Tokens",
        "tags": [
          "relay"
        ]
      }
    },
