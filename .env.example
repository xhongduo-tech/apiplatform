# 复制为 .env 后再启动生产环境。请为每个部署生成独立随机值，勿提交 .env。
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
# 32 字节独立密钥的 URL-safe base64（不要与 JWT_SECRET 复用）：
# openssl rand -base64 32 | tr '/+' '_-' | tr -d '=\n'
DATA_ENCRYPTION_KEY=
# 生产必填：首次管理员认领时必须同时提供的一次性高熵令牌。管理员密码成功
# 初始化后此值不再参与后续登录。请用 `openssl rand -hex 32` 生成。
ADMIN_BOOTSTRAP_TOKEN=
JWT_ISSUER=open-api-platform
JWT_AUDIENCE=open-api-platform
JWT_TTL_HOURS=4
USER_JWT_TTL_HOURS=8
# false 只允许回环 HTTP 首次认领；扩大 HTTP_BIND_ADDRESS 或接入域名前必须先
# 在可信代理终结 HTTPS，并改为 true。
SESSION_COOKIE_SECURE=false
ADMIN_SENSITIVE_ACTION_MAX_AGE_S=600
ALLOW_ADMIN_RAW_BACKUP_DOWNLOAD=false
ALLOW_PUBLIC_REGISTRATION=false
ALLOW_PASSWORD_RECOVERY=false
GRAFANA_DISABLE_INITIAL_ADMIN_CREATION=true
GRAFANA_ADMIN_PASSWORD=

# 首次管理员设密前保持回环监听。完成初始化后再改为 0.0.0.0、指定管理网地址
# 或交给带访问控制的反向代理。
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=80
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379
PROMETHEUS_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
# Docker json-file 日志轮换，避免长期运行耗尽宿主机磁盘。
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=5
# 可选：nginx 前置反向代理的精确 IP/CIDR，多个值逗号分隔。切勿填写
# 0.0.0.0/0 或 ::/0；留空时平台只使用直接连接地址做认证限流。
TRUSTED_PROXY_CIDRS=

# 首次打开 /admin.html 时由管理员自行设置平台后台密码，不在环境变量中预置。

# 全新空库是否加载完全虚构的演示用户/项目/用量（已有用户或 Key 时必定跳过）。
DEMO_DATA_ENABLED=true
# 生产默认关闭 Swagger/ReDoc；公开接口请使用 docs/openapi-gateway.json。
API_DOCS_ENABLED=false

# 可选应用扩展（默认关闭）。逗号分隔，按声明顺序安装/启动；每项格式为
# python.module[:attribute]，省略 attribute 时读取模块级 extension 对象。
# 生产中任一扩展导入、版本、安装或启动失败都会阻止平台就绪。
APPLICATION_EXTENSIONS=

# 上游 HTTPS 默认校验证书。自签 CA 应安装到镜像信任链。
UPSTREAM_TLS_VERIFY=true

# 安全默认：所有模型全天受 RPM/TPM 保护。仅在已完成容量隔离和滥用风险评估后
# 才显式开启夜间窗口或 embedding/reranker 豁免。
NIGHT_UNLIMITED_ENABLED=false
NIGHT_UNLIMITED_START=19:00
NIGHT_UNLIMITED_END=07:30
RATE_LIMIT_MODEL_EXEMPTIONS_ENABLED=false
RATE_LIMIT_RPM=600
RATE_LIMIT_TPM=6000000
# 生成请求未提供 max_tokens 等字段时使用的保守输出预扣预算。
RATE_LIMIT_DEFAULT_MAX_OUTPUT_TOKENS=4096
PLATFORM_TIMEZONE=Asia/Shanghai

# Redis 连接、单命令和整段限流准入的超时。Sentinel overlay 会自动注入节点。
REDIS_CONNECT_TIMEOUT_S=2
REDIS_SOCKET_TIMEOUT_S=2
RATE_LIMIT_ADMISSION_TIMEOUT_S=3
REDIS_DB=0
# 仅 docker-compose.sentinel.yml overlay 使用；同机默认节点可留空由 overlay 注入。
REDIS_SENTINEL_NODES=
REDIS_SENTINEL_MASTER=apiplatform-master
# 启用 overlay 时必须设置与 REDIS_PASSWORD 不同的独立高熵值；空值会拒绝渲染。
# 不启用 overlay 时可保持为空。持久配置只接受字母、数字、下划线和连字符；
# 建议使用 README 的 `openssl rand -hex 32` 生成方式。
REDIS_SENTINEL_PASSWORD=

# 后端进程与连接预算。DB_APP_INSTANCES 是连接同一 PostgreSQL 的 backend 副本数；
# 扩容副本时必须同步调大，启动会按 SHOW max_connections 拒绝超额配置。
GUNICORN_WORKERS=4
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=4
DB_POOL_TIMEOUT_S=30
DB_APP_INSTANCES=1
DB_CONNECTION_RESERVE=32
HTTPX_MAX_CONNECTIONS=256
HTTPX_MAX_KEEPALIVE=64

# 用量内容默认不落库，只保留状态、Token、延迟与无正文错误分类。
USAGE_CONTENT_LOGGING_ENABLED=false
USAGE_LOG_RETENTION_DAYS=90
USAGE_PROFILE_RETENTION_DAYS=180

# 匿名状态看板的抗突发参数。
PUBLIC_STATUS_CACHE_TTL_S=10
PUBLIC_STATUS_QUERY_TIMEOUT_MS=3000
PUBLIC_STATUS_RATE_PER_MINUTE=120

# 已验证快照默认每小时一份，保留约 7 天。
BACKUP_INTERVAL_S=3600
BACKUP_RETENTION_COUNT=168
BACKUP_FAILURE_RETRY_S=60
BACKUP_MAX_CONSECUTIVE_FAILURES=3

# Grafana 默认不创建管理员且不允许匿名访问；启用时应同时设置独立强密码。
GRAFANA_ANONYMOUS_ENABLED=false
